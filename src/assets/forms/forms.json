{
    "_id": "form_create_user",
    "name": "Form création utilisateur",
    "description": "Formulaire complet de test permettant de valider tous les types d'inputs disponibles dans le moteur dynamique PUS.",
    "dataType": "Object",
    "dataKey": "userForm",
    "default": {},
    "inputs": [
        {
            "_id": "input_text",
            "name": "Nom complet",
            "description": "Nom complet de l'utilisateur",
            "dataType": "String",
            "dataKey": "fullName",
            "default": "",
            "inputGroup": "Simple",
            "inputType": "Text",
            "controls": {
                "required": [
                    true,
                    "Le nom complet est obligatoire."
                ],
                "trim": true
            },
            "limits": {
                "minLength": [
                    3,
                    "Minimum 3 caractères."
                ],
                "maxLength": [
                    80,
                    "Maximum 80 caractères."
                ]
            },
            "configurations": {
                "placeholder": "Jean-Pierre Kabungulu",
                "className": "col-12 md:col-6"
            }
        },
        {
            "_id": "input_textarea",
            "name": "Description",
            "description": "Description détaillée",
            "dataType": "String",
            "dataKey": "description",
            "default": "",
            "inputGroup": "Simple",
            "inputType": "Textarea",
            "controls": {
                "trim": true
            },
            "limits": {
                "maxLength": [
                    500,
                    "Maximum 500 caractères."
                ]
            },
            "configurations": {
                "placeholder": "Entrez une description...",
                "rows": 5,
                "className": "col-12"
            }
        },
        {
