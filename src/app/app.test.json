  "createUserModal": {
    "_id": "create-user-modal",
    "name": "Créer un utilisateur",
    "label": "Nouvel utilisateur",
    "description": "Renseignez les informations du nouvel utilisateur.",
    "dataType": "Object",
    "dataKey": "createUser",
    "uiComponent": "Form",
    "controls": {
      "closable": true,
      "closeOnEscape": true,
      "dismissibleMask": false,
      "lockWhileSubmitting": true,
      "waitForServerResponse": true,
      "closeOnSuccess": true,
      "confirmPassword": true,
      "showFeedback": true
    },
    "configurations": {
      "presentationMode": "Modal",
      "modalTitle": "Créer un utilisateur",
      "modalWidth": "38rem"
    },
    "inputs": [
      {
        "_id": "create-user-name",
        "name": "Nom",
        "label": "Nom complet",
        "description": "Nom complet de l’utilisateur",
        "dataType": "String",
        "dataKey": "name",
        "uiComponent": "Input",
        "inputGroup": "Simple",
        "inputType": "Text",
        "controls": {
          "required": [
            true,
            "Le nom est obligatoire"
          ],
          "trim": true,
          "autoFocus": true
        },
        "limits": {
          "minLength": [
            2,
            "Minimum 2 caractères"
          ],
          "maxLength": [
            120,
            "Maximum 120 caractères"
          ]
        },
        "configurations": {
          "icon": "pi pi-user",
          "placeholder": "Nom complet"
        }
      },
      {
        "_id": "create-user-email",
        "name": "Email",
        "label": "Adresse email",
        "description": "Adresse email de connexion",
        "dataType": "String",
        "dataKey": "email",
        "uiComponent": "Input",
        "inputGroup": "Simple",
        "inputType": "Text",
        "controls": {
          "required": [
            true,
            "L’adresse email est obligatoire"
          ],
          "trim": true,
          "lowercase": true
        },
        "limits": {
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$"
        },
        "configurations": {
          "icon": "pi pi-envelope",
          "placeholder": "utilisateur@peka.com",
          "autoComplete": "email"
        }
      },
      {
        "_id": "create-user-password",
        "name": "Mot de passe",
        "label": "Mot de passe",
        "description": "Mot de passe initial de l’utilisateur",
        "dataType": "String",
        "dataKey": "password",
        "uiComponent": "Input",
        "inputGroup": "Simple",
        "inputType": "Password",
        "controls": {
          "required": [
            true,
            "Le mot de passe est obligatoire"
          ],
          "feedback": true,
          "toggleMask": true
        },
        "limits": {
          "minLength": [
            8,
            "Minimum 8 caractères"
          ],
          "maxLength": [
            120,
            "Maximum 120 caractères"
          ]
        },
        "configurations": {
          "icon": "pi pi-lock",
          "placeholder": "Mot de passe",
          "autoComplete": "new-password"
        }
      }
    ]
  },
